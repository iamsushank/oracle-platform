# Copy to inventory.yml after: ./scripts/provision.sh
# Replace ansible_host with: terraform -chdir=terraform output -raw instance_public_ip

all:
  children:
    platform:
      hosts:
        oracle:
          ansible_host: YOUR_PUBLIC_IP
          ansible_user: deploy
          ansible_ssh_private_key_file: ~/.ssh/github_deploy
          ansible_ssh_common_args: '-o StrictHostKeyChecking=no'
