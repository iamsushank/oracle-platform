# Copy to terraform.tfvars and fill in from Oracle Cloud Console.
# NEVER commit terraform.tfvars (contains no secrets if you use private_key_path only).

tenancy_ocid     = "ocid1.tenancy.oc1..aaaa..."
user_ocid        = "ocid1.user.oc1..aaaa..."
fingerprint      = "aa:bb:cc:dd:..."
private_key_path = "~/.oci/oci_api_key.pem"
region           = "ap-mumbai-1"
compartment_ocid = "ocid1.compartment.oc1..aaaa..."

# Your laptop SSH public key (cat ~/.ssh/id_ed25519.pub)
ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

# Optional: separate key for GitHub Actions deploy user (recommended)
# deploy_ssh_public_key = "ssh-ed25519 AAAA... github-actions"

# Restrict SSH to your IP for better security
# admin_cidr = "203.0.113.10/32"

instance_name   = "platform"
shape_ocpus     = 2
shape_memory_gb = 12
