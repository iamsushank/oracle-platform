# Copy to .env.platform and fill in (never commit .env.platform).
# After filling: ./scripts/bootstrap.sh

# ── OCI (from Oracle Console or ~/.oci/config after `oci setup config`) ──
OCI_TENANCY_OCID=ocid1.tenancy.oc1..aaaa
OCI_USER_OCID=ocid1.user.oc1..aaaa
OCI_FINGERPRINT=aa:bb:cc:dd:ee:...
OCI_REGION=ap-mumbai-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..aaaa
OCI_PRIVATE_KEY_PATH=~/.oci/oci_api_key.pem

# ── Optional: auto-read from ~/.oci/config if vars above are empty ──
# OCI_USE_LOCAL_CONFIG=true

# ── OCI Object Storage (Customer Secret Key for Terraform remote state) ──
OCI_S3_ACCESS_KEY=
OCI_S3_SECRET_KEY=

# ── GitHub (for gh secret set + first deploy trigger) ──
GITHUB_OWNER=iamsushank
WEBHOOK_INGESTOR_REPO=webhook-ingestor
# Space-separated owner/repo list (defaults to GITHUB_OWNER/WEBHOOK_INGESTOR_REPO)
# APP_REPOS=iamsushank/webhook-ingestor iamsushank/my-other-app

# ── GHCR pull (only if images are PRIVATE; leave blank for public packages) ──
# GHCR_USER=iamsushank
# GHCR_PULL_TOKEN=ghp_xxx   # PAT with read:packages

# ── SSH (generated automatically if paths don't exist) ──
PLATFORM_SSH_KEY=~/.ssh/oracle_platform
DEPLOY_SSH_KEY=~/.ssh/github_deploy

# ── Terraform tuning ──
TF_INSTANCE_NAME=platform
TF_SHAPE_OCPUS=2
TF_SHAPE_MEMORY_GB=12
# TF_ADMIN_CIDR=0.0.0.0/0
